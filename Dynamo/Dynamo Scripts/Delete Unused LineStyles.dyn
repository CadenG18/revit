{
  "Uuid": "a8cf20de-8be0-4e8d-873a-23fa4a253c9f",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Delete Unused LineStyles",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "9e7df0310984405587f8537d58a908e6",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": ""
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\n#import Autodesk\r\nfrom System.Collections.Generic import *\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference('ProtoGeometry')\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nimport Autodesk\r\nfrom Autodesk.DesignScript.Geometry import *\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom Autodesk.Revit.DB.Architecture import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\nuidoc=DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nrevVersion = int(app.VersionNumber)\r\nwatch = []\r\n\r\ndummyCrv = UnwrapElement(IN[0])\r\n\r\nidIntsInUse = []\r\ncurves = FilteredElementCollector(doc).OfClass(CurveElement)\r\nfor crvElem in curves:\r\n    styleId = crvElem.LineStyle.Id.IntegerValue\r\n    idIntsInUse.append(styleId)\r\n    \r\nidIntsInUse = list(set(idIntsInUse))\r\n\r\nstyleIds = dummyCrv.GetLineStyleIds()\r\n\r\nidsToDelete = List[ElementId]()\r\nfor sId in styleIds:\r\n    style = doc.GetElement(sId)\r\n    if style == None: continue\r\n    if style.Name[0] == \"<\": continue\r\n    \r\n    if sId.IntegerValue in idIntsInUse: continue\r\n    \r\n    watch.append(style.Name)\r\n    idsToDelete.Add(sId)\r\n    \r\ntr = Transaction(doc, \"Purge unused line styles\")\r\ntr.Start()\r\ndoc.Delete(idsToDelete)\r\ntr.Commit()\r\n    \r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\n#dataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = watch",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "6ce32805699045d7b71eb4bf11d118f3",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "2b53cd9d9e97486eb879f4f4159d92c6",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "26788ebec8e4411da859acc506a9bf69",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
