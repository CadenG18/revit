    {
      "ConcreteType": "DSRevitNodesUI.Views, DSRevitNodesUI",
      "SelectedIndex": 277,
      "SelectedString": "POWER - SEGMENTS MASTER",
      "Id": "742503726fe340aa933cf5879f8a77c9",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "a1373004978e46a3bdfc99e28e82f849",
          "Name": "Views",
          "Description": "The selected Views",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "All views available in the current document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo/Revit imports\r\nimport clr\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import FilteredElementCollector, BuiltInCategory, XYZ\r\nfrom Autodesk.Revit.DB.Electrical import Wire, WireType, WiringType\r\n\r\n# Current document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Inputs from Dynamo\r\nfixtures = UnwrapElement(IN[0])  # list of electrical fixtures\r\nview = UnwrapElement(IN[1])      # view to draw wires in\r\n\r\n# Get first available WireType\r\nwire_types = FilteredElementCollector(doc)\\\r\n    .OfCategory(BuiltInCategory.OST_Wire)\\\r\n    .WhereElementIsElementType()\\\r\n    .ToElements()\r\nwire_type = wire_types[0] if len(wire_types) > 0 else None\r\n\r\nwire_length = 4.0  # feet offset from connector\r\nwires_created = []\r\n\r\ndef get_first_connector(element):\r\n    \"\"\"Return the first electrical Connector object of an element, or None.\"\"\"\r\n    conns = None\r\n    # For family instances\r\n    if hasattr(element, \"MEPModel\") and element.MEPModel:\r\n        cm = element.MEPModel.ConnectorManager\r\n        if cm:\r\n            conns = cm.Connectors\r\n    # For other MEP elements\r\n    elif hasattr(element, \"ConnectorManager\") and element.ConnectorManager:\r\n        conns = element.ConnectorManager.Connectors\r\n\r\n    if conns:\r\n        for c in conns:\r\n            return c\r\n    return None\r\n\r\nif wire_type is not None:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    for fixture in fixtures:\r\n        start_connector = get_first_connector(fixture)\r\n\r\n        if start_connector:\r\n            start_pt = start_connector.Origin\r\n            # Create an artificial end point 4ft in +Y direction\r\n            end_pt = XYZ(start_pt.X, start_pt.Y + wire_length, start_pt.Z)\r\n\r\n            vertices = [start_pt, end_pt]\r\n\r\n            try:\r\n                # Here startConnector is the actual connector on the fixture\r\n                # endConnector is None (free end)\r\n                wire = Wire.Create(doc,\r\n                                   wire_type.Id,\r\n                                   view.Id,\r\n                                   WiringType.Arc,\r\n                                   vertices,\r\n                                   start_connector,\r\n                                   None)\r\n                wires_created.append(wire)\r\n            except Exception as e:\r\n                wires_created.append(\"Error: {}\".format(e))\r\n        else:\r\n            wires_created.append(\"No connector found for element ID {}\".format(fixture.Id))\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = wires_created\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "39dc0dbb4b1d49dcb11b0ba37329358f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "d44239012c264e0aad67a24ff54a8ade",
          "Name": "IN[0]",
          "Description": "Input #0",
