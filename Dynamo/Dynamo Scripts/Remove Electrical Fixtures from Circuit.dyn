    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "#Enable Python support and load DesignScript library\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n#import Revit Nodes\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n#import RevitAPI\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\n\r\n#import DocumentManager and TransactionManager\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n#The inputs to this node will be stored as a list in the IN variables.\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nElectricalComponents = UnwrapElement(IN[0])\r\nElectricalCircuits = UnwrapElement(IN[1])\r\nElecSet = ElementSet()\r\n\r\n#Place your code below this line\r\nfor element in ElectricalComponents:\r\n\tElecSet.Insert(element)\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor circuit in ElectricalCircuits:\r\n\tcircuit.RemoveFromCircuit(ElecSet)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n#Assign your output to the OUT variable.\r\nOUT = ElectricalCircuits",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "1a8263aa7d0c47b180c2e2ba82bd0e20",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "470031f0c77f4e03a1aa0efd20af23b6",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "eabd795895384ca185d75d74e3d7c43d",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e159a03d04a44f34bbf5250a0780111d",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
