    },
    {
      "ConcreteType": "CoreNodeModels.Input.FileObject, CoreNodeModels",
      "NodeType": "ExtensionNode",
      "Id": "5441c98483c642448ee1395c9f2ba8a9",
      "Inputs": [
        {
          "Id": "d10e52878bef46498b6b2e6314c3f22d",
          "Name": "path",
          "Description": "Path to the file.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7d146bb369f04ecba76e9571fcc94b15",
          "Name": "file",
          "Description": "File object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a file object from a path."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables\r\ndataEnteringNode = IN\r\n\r\n# Get the current Revit document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Input from the Excel data\r\nexcel_data = IN[0]  # List of rows from the Excel sheet\r\n\r\n# Start a transaction to make changes in the Revit model\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n# Iterate through the Excel data (skipping header rows if necessary)\r\nfor row in excel_data[1:]:  # Start from the second row, assuming the first row is a header\r\n    if len(row) < 2:\r\n        continue  # Skip rows with insufficient data\r\n\r\n    load_name, unique_id = row[0], row[1]\r\n\r\n    # Get the element by UniqueId\r\n    element = doc.GetElement(unique_id)\r\n    if element:\r\n        electrical_systems = element.MEPModel.GetElectricalSystems()\r\n        for electrical_system in electrical_systems:\r\n            # Update the Load Name\r\n            if electrical_system and electrical_system.LoadName != load_name:\r\n                electrical_system.LoadName = load_name\r\n\r\n# End the transaction\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Output the result\r\nOUT = \"Load names updated successfully!\"\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "a9279c43ba7b4da7b4a8c34ecd096f6b",
      "Inputs": [
        {
          "Id": "04e9e6a772834ff5a2110890c27db12a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "07655c80a692403f9ccf447f8424345f",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
