    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "headers = [ [\"Load Name\", \"Element ID\", \"kVA\", \"Voltage\", \"Phase\", \"Breaker Size\", \"Paneled By\"] ];",
      "Id": "b5bf5c8f03ec4ce8a3c57d1a891b3446",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "76f8e4dd55cf42f4a6a5bcfe54f9c84d",
          "Name": "",
          "Description": "headers",
          "UsingDefaultValue": false,
          "Level": 2,
