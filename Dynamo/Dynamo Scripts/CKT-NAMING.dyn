    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nimport System.Collections.Generic\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Get the current Revit document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Get all family instances of the specified types\r\nelement_types = ['EF_Duplex Receptacle_R2018']\r\nelements = FilteredElementCollector(doc)\\\r\n    .OfClass(FamilyInstance)\\\r\n    .WhereElementIsNotElementType()\\\r\n    .ToElements()\r\n\r\n# Initialize a dictionary to count load names\r\nload_name_counts = {}\r\n\r\n# First pass: count occurrences of each load name\r\nfor elem in elements:\r\n    if elem.Symbol.Family.Name in element_types:\r\n        electrical_systems = elem.MEPModel.GetElectricalSystems()\r\n        for electrical_system in electrical_systems:\r\n            load_name = electrical_system.LoadName if electrical_system.LoadName else \"N/A\"\r\n            if load_name in load_name_counts:\r\n                load_name_counts[load_name] += 1\r\n            else:\r\n                load_name_counts[load_name] = 1\r\n\r\n# Second pass: filter out elements with duplicate load names\r\nresults = []\r\nfor elem in elements:\r\n    if elem.Symbol.Family.Name in element_types:\r\n        electrical_systems = elem.MEPModel.GetElectricalSystems()\r\n        for electrical_system in electrical_systems:\r\n            load_name = electrical_system.LoadName if electrical_system.LoadName else \"N/A\"\r\n            if load_name_counts.get(load_name, 0) == 1:\r\n                # Get the required parameters\r\n                load_param = electrical_system.get_Parameter(BuiltInParameter.RBS_ELEC_APPARENT_LOAD)\r\n                voltage_param = electrical_system.get_Parameter(BuiltInParameter.RBS_ELEC_VOLTAGE)\r\n\r\n                apparent_load = load_param.AsValueString() if load_param and load_param.HasValue else \"N/A\"\r\n                voltage = voltage_param.AsValueString() if voltage_param and voltage_param.HasValue else \"N/A\"\r\n                \r\n                rating = electrical_system.Rating if electrical_system.Rating else 0.0\r\n                poles_number = electrical_system.PolesNumber if electrical_system.PolesNumber else 0\r\n                panel_name = electrical_system.PanelName if electrical_system.PanelName else \"N/A\"\r\n                unique_id = elem.UniqueId\r\n\r\n                # Append the results with UniqueId included\r\n                results.append((load_name, unique_id, apparent_load, voltage, poles_number, rating, panel_name))\r\n\r\n# Assign your output to the OUT variable\r\nOUT = results\r\n\r\n\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1887021cec0e460b83dd242b5626b821",
      "Inputs": [
